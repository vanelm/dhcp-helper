# Comma-separated interfaces to capture (e.g. eth0 or eth0,eth1)
DHCP_IFACES=eth0

# Profiler DHCP listener address (host:port)
DHCP_TARGET=profiler-ms:4578

# Hostname shown in Dozzle UI for this agent (must be unique across all hosts).
# Run once on the host: echo "DOZZLE_AGENT_HOSTNAME=$(hostname)" >> .env
DOZZLE_AGENT_HOSTNAME=
