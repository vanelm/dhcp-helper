[Unit]
Description=DHCP Helper - Passive DHCP Fingerprint Forwarder
After=network.target

[Service]
Type=simple
EnvironmentFile=-/etc/default/dhcp-helper
ExecStart=/usr/local/bin/dhcp-helper -i ${INTERFACES} -t ${TARGET} -s /run/dhcp-helper.sock
Restart=on-failure
RestartSec=5
AmbientCapabilities=CAP_NET_RAW CAP_NET_ADMIN
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
